{
  "name": "zirconiabot",
  "version": "1.0.0",
  "description": "A Discord bot with simple repliy, janken, dice and gacha commands",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "wrangler dev",
    "tunnel": "cloudflared tunnel --url http://localhost:8787 --no-autoupdate",
    "ngrok": "ngrok http 8787",
    "test": "c8 mocha test",
    "fix": "eslint --fix '**/*.js'",
    "lint": "eslint '**/*.js'",
    "register": "node src/register.js",
    "deploy": "wrangler deploy",
    "deploy:full": "npm run register && npm run deploy"
  },
  "keywords": [],
