    "itty-router": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "c8": "^11.0.0",
    "chai": "^6.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.1.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.6.0",
    "mocha": "^8.1.3",
    "ngrok": "^4.3.3",
    "prettier": "^3.2.5",
    "sinon": "^22.0.0",
    "wrangler": "^4.13.2"
